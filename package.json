{
  "name": "godot-mcp-local",
  "version": "1.0.0",
  "private": true,
  "description": "A hardened, least-privilege MCP server for Godot 4 development, runtime inspection and UI testing",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "cline",
    "game-engine",
    "gdscript",
    "runtime",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/anthonypaddison/godot-mcp",
  "bugs": {
    "url": "https://github.com/anthonypaddison/godot-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anthonypaddison/godot-mcp.git"
  },
  "mcpName": "godot-mcp",
  "license": "MIT",
  "author": "Tugcan Topaloglu",
  "contributors": [
    "Solomon Elias <solomon@sippy.ai> (https://github.com/Coding-Solo)"
  ],
  "type": "module",
  "bin": {
    "godot-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:stdio": "npm run build && node scripts/test-stdio-hygiene.js",
    "test:stale-token": "node scripts/test-stale-session-token.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "path-to-regexp": "8.4.0",
    "qs": "6.15.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^5.3.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
